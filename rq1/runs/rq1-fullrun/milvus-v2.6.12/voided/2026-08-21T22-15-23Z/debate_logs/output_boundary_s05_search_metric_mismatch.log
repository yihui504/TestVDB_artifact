CASE no metric (default)      status=200 ok=True | {"code":0,"cost":0,"data":[{"distance":0,"id":1}],"topks":[1]}

CASE matching L2              status=200 ok=True | {"code":0,"cost":0,"data":[{"distance":0,"id":1}],"topks":[1]}

CASE diff IP                  status=200 ok=True | {"code":0,"cost":0,"data":[{"distance":0,"id":1}],"topks":[1]}

VERDICT_DEFECT 1 s05 diff IP accepted
CASE diff COSINE              status=200 ok=True | {"code":0,"cost":0,"data":[{"distance":0,"id":1}],"topks":[1]}

VERDICT_DEFECT 1 s05 diff COSINE accepted
CASE bogus METRIC             status=200 ok=True | {"code":0,"cost":0,"data":[{"distance":0,"id":1}],"topks":[1]}

VERDICT_DEFECT 1 s05 bogus METRIC accepted
CASE lowercase l2             status=200 ok=True | {"code":0,"cost":0,"data":[{"distance":0,"id":1}],"topks":[1]}

CASE int metric               status=200 ok=True | {"code":0,"cost":0,"data":[{"distance":0,"id":1}],"topks":[1]}

VERDICT_DEFECT 1 s05 int metric accepted
VERDICT_DEFECT_FOUND
