      "expected_behavior": "get collection returns 200 OK, list collections includes new collection",
      "related_endpoints": [
        "collections+create",
        "collections+get",
        "collections+list"
      ],
      "source_url": "https://api.qdrant.tech/api-reference/collections/create-collection"
    },
    {
      "contract_id": "qdrant_behavioral_delete_invisibility_001",
      "description": "Deleted collection should not be visible in get collection and list collections",
      "scenario": "Delete collection -> get collection -> collection not in list",
      "expected_behavior": "get collection returns 404, list collections does not include deleted collection",
      "related_endpoints": [
