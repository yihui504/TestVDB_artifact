      "doc_version": "1.19.x",
      "parameters": [
        {
          "name": "collection_name",
          "type": "string",
          "required": true,
          "description": "Name of the collection"
        },
        {
          "name": "vectors",
          "type": "object",
          "required": true,
          "description": "Vector configuration with size and distance metric"
        },
        {
          "name": "hnsw_config",
          "type": "object",
          "required": false,
          "description": "HNSW index parameters (m, ef_construct)"
