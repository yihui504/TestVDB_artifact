  "defect_criteria": {
    "confirmed_defect_patterns": [
      {
        "pattern": "Empty vector [] accepted in batch/objects but rejected in singular POST /v1/objects",
        "classification": "Type1_IllegalSuccess",
        "severity_default": "High",
        "rationale": "Direct violation of API contract - batch endpoint should reject invalid vectors same as singular endpoint"
      },
      {
        "pattern": "shardingConfig.desiredCount accepts negative values but rejects zero",
        "classification": "Type1_IllegalSuccess",
        "severity_default": "High",
        "rationale": "Negative shard counts are physically impossible but accepted without validation"
      },
      {
        "pattern": "TTL context canceled mid-deletion leaves tenant permanently HOT",
        "classification": "Type4_StateViolation",
        "severity_default": "Critical",
        "rationale": "System state corruption preventing tenant management operations"
      },
      {
