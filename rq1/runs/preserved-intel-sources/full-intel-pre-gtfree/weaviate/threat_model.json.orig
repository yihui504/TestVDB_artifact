  "cognitive_blindspots": {
    "blindspots": [
      {
        "blindspot_id": "BS-01",
        "name": "Parameter Coercion Trust",
        "description": "Developers over-trust framework-level type coercion and automatic validation in request parsing, assuming invalid inputs will be rejected before business logic",
        "evidence": {
          "historical_defects": 42,
          "representative_issues": [11981, 11729, 11436, 11325, 10771],
          "developer_acknowledgment_rate": 1.0,
          "root_cause": "parameter_validation",
          "affected_layer": "request_parsing"
        },
        "typical_manifestation": "REST handler accepts parameters via framework binding without explicit validation logic, allowing empty vectors, negative integers, and null values to propagate to business logic",
        "attack_strategies": ["type_confusion_attack", "missing_param_attack", "null_coercion_attack"],
        "defense_recommendation": "Add explicit parameter validation middleware at API boundaries that enforces type, range, and required field constraints before business logic",
        "cross_db_transferable": true,
        "applicable_dbs": ["milvus", "qdrant", "weaviate", "pgvector"],
        "severity_impact": "P0/P1"
      },
      {
        "blindspot_id": "BS-02",
        "name": "Error Message Negligence",
        "description": "Developers focus on success paths and crash prevention, treating error messages as implementation details rather than user-facing diagnostics",
        "evidence": {
          "historical_defects": 17,
          "representative_issues": [11275, 10258, 9340, 8912, 8425],
          "developer_acknowledgment_rate": 0.95,
          "root_cause": "error_handling",
          "affected_layer": "business_logic"
        },
        "typical_manifestation": "Errors return generic 'Invalid request' or 'Internal error' without specifying which parameter failed or why, making debugging client-side issues difficult",
        "attack_strategies": ["error_quality_evaluation", "diagnostic_gap_analysis"],
        "defense_recommendation": "Establish error message quality standards requiring: parameter name, expected value range, actual received value, and corrective action for all 4xx responses",
        "cross_db_transferable": true,
        "applicable_dbs": ["milvus", "qdrant", "weaviate", "pgvector"],
        "severity_impact": "P2"
      },
      {
        "blindspot_id": "BS-03",
        "name": "Concurrency Blindness",
        "description": "Developers underestimate data consistency issues in concurrent operations, assuming linearizability where the implementation only provides eventual consistency",
        "evidence": {
          "historical_defects": 15,
          "representative_issues": [11055, 10581, 9918, 9368, 9320],
          "developer_acknowledgment_rate": 1.0,
          "root_cause": "concurrency_race",
          "affected_layer": "storage_engine"
        },
        "typical_manifestation": "Concurrent tenant deletion + TTL cancellation leaves tenant in HOT state; async indexing interrupted by restart never completes; backup during collection deletion causes data loss",
        "attack_strategies": ["state_consistency_attack", "race_condition_exploration", "operation_cancellation_race"],
        "defense_recommendation": "Add transactional bounds or compensating transactions for state-changing operations; implement operation fencing to prevent conflicting concurrent state modifications",
        "cross_db_transferable": true,
        "applicable_dbs": ["milvus", "qdrant", "weaviate", "pgvector"],
        "severity_impact": "P0/P1"
      },
      {
        "blindspot_id": "BS-04",
        "name": "Boundary Default Optimism",
        "description": "Developers assume users won't input extreme values, relying on default value handling rather than explicit boundary validation",
        "evidence": {
          "historical_defects": 5,
          "representative_issues": [11668, 11667, 8621, 8035, 6491],
          "developer_acknowledgment_rate": 1.0,
          "root_cause": "boundary_handling",
          "affected_layer": "data_access"
        },
        "typical_manifestation": "Negative ef=-1, limit=-100, desiredCount=-1 accepted without validation; dimension=0 causes infinite loops; bias dimensions violate mathematical invariants",
        "attack_strategies": ["boundary_value_attack", "negative_value_attack", "extreme_input_attack"],
        "defense_recommendation": "Add explicit min/max validation for all numeric parameters with documented ranges; validate mathematical invariants (dimension > 0, count >= 0) at API entry point",
        "cross_db_transferable": true,
        "applicable_dbs": ["milvus", "qdrant", "weaviate", "pgvector"],
        "severity_impact": "P1"
      },
      {
        "blindspot_id": "BS-05",
        "name": "Documentation Contract Drift",
        "description": "Implementation changes outpace documentation updates, creating discrepancies between documented API behavior and actual runtime behavior",
        "evidence": {
          "historical_defects": 13,
          "representative_issues": [10231, 9801, 9447, 8914, 8425],
          "developer_acknowledgment_rate": 0.85,
          "root_cause": "state_consistency",
          "affected_layer": "data_access"
        },
        "typical_manifestation": "Documentation says parameter X is required but it's optional; behavior changed in v1.33 but docs reference v1.30; error messages don't match documented examples",
        "attack_strategies": ["api_contract_validation", "behavioral_drift_detection", "documentation_compliance_check"],
        "defense_recommendation": "Treat documentation as executable contract; add CI tests that validate documented examples against actual API responses; auto-generate docs from OpenAPI spec",
        "cross_db_transferable": true,
        "applicable_dbs": ["milvus", "qdrant", "weaviate", "pgvector"],
        "severity_impact": "P1/P2"
      }
    ],
