    "submission_guidance": {
      "required_evidence": [
        "Minimal reproduction script (MRE) that triggers the defect",
        "Expected vs actual behavior with documentation references",
        "Weaviate version and environment details",
        "For state violations: before/after state showing the corruption"
      ],
      "recommended_format": {
        "title": "[Bug] <summary of violation>",
        "body": [
          "**Description**: Clear statement of defect",
          "**Documentation Reference**: Link to official docs being violated",
          "**Steps to Reproduce**: Numbered minimal steps",
          "**Expected Behavior**: What docs say should happen",
          "**Actual Behavior**: What actually happens (with logs/output)",
          "**Environment**: Weaviate version, deployment type",
          "**Impact**: Why this matters (data loss, crash, incorrect results, etc.)"
        ]
      },
      "pitfalls_to_avoid": [
        "Reporting behaviors that match documentation as bugs",
        "Submitting error quality issues without suggested improvement text",
        "Reporting extreme concurrency scenarios without mitigation strategies",
        "Omitting reproduction steps for state corruption issues"
      ]
    }
