  "defect_criteria": {
    "confirmed_defect_patterns": [
      {
        "pattern": "filter.should=null silently accepted in query/search",
        "classification": "Type1_IllegalSuccess",
        "severity_default": "High",
        "rationale": "Issues #9418, #9420 - developer confirmed null filter should be rejected but is silently treated as no-filter"
      },
      {
        "pattern": "query=null returns all points instead of being rejected",
        "classification": "Type1_IllegalSuccess",
        "severity_default": "High",
        "rationale": "Issue #9420 - invalid null query accepted, returns unexpected results"
      },
      {
        "pattern": "vectors={} or missing vectors config accepted during collection creation",
        "classification": "Type1_IllegalSuccess",
        "severity_default": "High",
        "rationale": "Issues #9416, #9417 - creates unusable collections, should be rejected at creation time"
      },
      {
        "pattern": "filter.must_not accepts object instead of array",
        "classification": "Type1_IllegalSuccess",
        "severity_default": "High",
        "rationale": "Issue #9419 - type mismatch silently ignored, should validate array type"
      },
      {
        "pattern": "WAL replay resurrects filter-deleted points",
        "classification": "Type4_StateViolation",
        "severity_default": "Critical",
        "rationale": "Issue #9575 - deleted points reappear after WAL replay, fundamental state consistency violation"
      },
      {
        "pattern": "empty vector [] with wait=false triggers panic",
        "classification": "Type3_RuntimeFailure",
        "severity_default": "Critical",
        "rationale": "Issue #9045 - zero-length assertion failure causes server crash"
      },
      {
        "pattern": "shard_number=0 or negative values accepted",
        "classification": "Type1_IllegalSuccess",
        "severity_default": "High",
        "rationale": "Issue #9149 - invalid shard configuration should be rejected"
      },
      {
        "pattern": "recommend API silently ignores missing positive/negative point IDs",
        "classification": "Type4_StateViolation",
        "severity_default": "Medium",
        "rationale": "Issue #9390 - silent failure instead of explicit error"
      }
    ],
    "by_design_behaviors": [
      {
        "pattern": "HNSW approximation may return duplicate points across offset-based pagination",
        "specific_example": "POST /collections/{collection}/points/search with offset=10, limit=10 can return the same point in page 1 and page 2 due to approximate nearest neighbor graph",
        "source_issue_numbers": [
          9523
        ],
        "affected_endpoints": [
          "POST /collections/{collection}/points/search",
          "POST /collections/{collection}/points/scroll"
        ],
        "verdict": "DO_NOT_REPORT",
        "rationale": "Issue #9523 - maintainer confirmed this is a known limitation of HNSW approximate search, not a defect"
      },
      {
        "pattern": "jemalloc crashes with 'Unsupported system page size' on ARM64/aarch64",
        "specific_example": "qdrant container crashes on ARM64 with large page sizes (64KB) configured at OS level - jemalloc limitation",
        "source_issue_numbers": [
          3831,
          4298,
          6512,
          7246
        ],
        "affected_endpoints": [
          "startup",
          "all endpoints"
        ],
        "verdict": "DO_NOT_REPORT",
        "rationale": "External jemalloc dependency limitation - maintainer acknowledged but deprioritized as infrastructure constraint"
      },
      {
        "pattern": "Snapshot creation timeout/ReadTimeout on large collections",
        "specific_example": "Python client create_snapshot returns ReadTimeout when creating snapshot on large (>100GB) collections",
        "source_issue_numbers": [
          4802
        ],
        "affected_endpoints": [
          "POST /collections/{collection}/snapshots"
        ],
        "verdict": "VERIFY_FIRST",
        "rationale": "May be resource exhaustion vs defect - check if collection is truly large or if snapshot process is stuck"
      },
      {
        "pattern": "Idempotent DELETE returns 200 even if point doesn't exist",
        "specific_example": "DELETE /collections/{collection}/points/{id} returns 200 OK even when point ID was never inserted",
        "source_issue_numbers": [],
        "affected_endpoints": [
          "DELETE /collections/{collection}/points"
        ],
        "verdict": "DO_NOT_REPORT",
        "rationale": "RESTful idempotent delete design - 200 OK is correct response for successful idempotent operation"
      },
      {
        "pattern": "wait=false operations succeed but errors are not logged",
        "specific_example": "POST /collections/{collection}/points with wait=false returns 202 but operation fails - error only visible in logs",
        "source_issue_numbers": [
          4925
        ],
        "affected_endpoints": [
          "POST /collections/{collection}/points",
          "POST /collections/{collection}/snapshots"
        ],
        "verdict": "REPORT_AS_P3",
        "rationale": "Issue #4925 - acknowledged limitation of async operations - low priority enhancement request"
      },
      {
        "pattern": "filter=null in query/search is treated as no-filter",
        "specific_example": "POST /collections/{collection}/points/search with filter=null returns all points instead of rejecting null filter",
        "source_issue_numbers": [],
        "affected_endpoints": [
          "POST /collections/{collection}/points/search",
          "POST /collections/{collection}/points/query"
        ],
        "verdict": "VERIFY_FIRST",
        "rationale": "May be intentional API design (null means no filter) vs validation bug - check API specification"
      },
      {
        "pattern": "with_payload parameter defaults to false",
        "specific_example": "POST /collections/{collection}/points/search returns results without payload unless with_payload=true explicitly set",
        "source_issue_numbers": [],
        "affected_endpoints": [
          "POST /collections/{collection}/points/search",
          "POST /collections/{collection}/points/scroll"
        ],
        "verdict": "DO_NOT_REPORT",
        "rationale": "Documented default behavior - API specification defines with_payload=false as default"
      },
      {
        "pattern": "Distance enum uses 'Euclid' not 'Euclidean'",
        "specific_example": "Distance metric enum value is 'Euclid' not 'Euclidean' in API responses",
        "source_issue_numbers": [],
        "affected_endpoints": [
          "GET /collections/{collection}"
        ],
        "verdict": "DO_NOT_REPORT",
        "rationale": "API design choice - 'Euclid' is the official enum name per specification"
      },
      {
        "pattern": "HNSW search with high ef/limit may return non-deterministic tie-breaking results",
        "specific_example": "Multiple searches with same query may return slightly different ordering for points with equal scores",
        "source_issue_numbers": [],
        "affected_endpoints": [
          "POST /collections/{collection}/points/search"
        ],
        "verdict": "DO_NOT_REPORT",
        "rationale": "Approximate search non-determinism is documented HNSW characteristic"
      },
      {
        "pattern": "Error message field names like 'status', 'time', 'error' are not part of contract",
        "specific_example": "Error responses contain fields like 'status.error' - schema varies by error type",
        "source_issue_numbers": [],
        "affected_endpoints": [
          "all endpoints"
        ],
        "verdict": "DO_NOT_REPORT",
        "rationale": "Error message structure is implementation detail, not guaranteed API contract"
      }
