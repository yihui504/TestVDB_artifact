      {
        "blindspot_id": "BS-01",
        "name": "Parameter Type Coercion Trust",
        "description": "Developer team assumes REST API framework/serde validates complex nested structures like filter conditions, but validation gaps allow null/object/array type mismatches through silently",
        "evidence": {
          "historical_defects": "88 instances across filter/query validation",
          "representative_issues": [
            9418,
            9419,
            9420,
            9416,
            9417
          ],
          "developer_acknowledgment_rate": "0.85 (85% of similar issues acknowledged as bugs)",
          "recent_fixes": [
            "#7218 - Fix missing REST API Filter validations",
            "#7217 - Fix missing API validation for MinShould",
            "#7220 - Fix missing REST API validations misc."
          ]
        },
        "typical_manifestation": "filter.should=null, filter.must_not=object, query=null, vectors={} all accepted with 200 OK but produce undefined behavior",
        "attack_strategies": [
          "type_confusion_attack",
          "missing_parameter_attack",
          "boundary_value_attack"
        ],
        "defense_recommendation": "Implement strict schema validation at API boundary - reject null where array expected, validate nested structure types explicitly",
        "cross_db_transferable": true,
        "applicable_dbs": [
          "milvus",
          "qdrant",
          "weaviate",
          "pgvector"
        ],
        "severity_impact": "P0/P1",
        "version_status": {
