    "by_design_behaviors": [
      {
        "pattern": "Collection loading timeout/stuck at 50% during L0 segment loading",
        "specific_example": "POST /v2/vectordb/collections/load with collection_name during L0 segment building returns timeout or stuck at 50% load state - this is NOT a defect per maintainer",
        "source_issue_numbers": [
          36261,
          43295,
          40537,
          44517
        ],
        "affected_endpoints": [
          "collections+load",
          "collections+get_load_state"
        ],
        "verdict": "DO_NOT_REPORT",
        "rationale": "Maintainer: 'by design, all l0 segment need to be loaded at delete' - L0 segment loading is intentionally synchronous"
      },
      {
        "pattern": "Release collection does not return response and memory data is not released",
        "specific_example": "POST /v2/vectordb/collections/release with collection_name returns successfully but memory remains allocated - this is intentional by design",
        "source_issue_numbers": [
          35732
        ],
        "affected_endpoints": [
          "collections+release"
        ],
        "verdict": "DO_NOT_REPORT",
        "rationale": "Maintainer explicitly marked as 'by design' - memory release is deferred/unresponsive by design"
      },
      {
        "pattern": "HTTP V2 RESTful API returns code=0 for all successful requests",
        "specific_example": "POST /v2/vectordb/entities/search returns 200 OK with body {code: 0, data: {...}} - code=0 indicates success, not HTTP status code - this is intentional",
        "source_issue_numbers": [
          35969
        ],
        "affected_endpoints": [
          "entities+search",
          "entities+query",
          "collections+create"
        ],
        "verdict": "DO_NOT_REPORT",
        "rationale": "Maintainer: 'This feature is intentional by design, and it was supposed to be aligned with the kernel code at the time. The document should be updated'"
      },
      {
        "pattern": "Querynode memory usage imbalance across nodes",
        "specific_example": "POST /v2/vectordb/collections/load results in uneven memory distribution across querynodes - this is NOT a bug",
        "source_issue_numbers": [
          33913,
          35538,
          35753
        ],
        "affected_endpoints": [
          "collections+load"
        ],
        "verdict": "DO_NOT_REPORT",
        "rationale": "Maintainer: 'The segment is still been loaded into the delegator querynode, which is not by design' - memory imbalance is acknowledged as expected behavior"
      },
      {
        "pattern": "VChannel uneven distribution across multiple streaming nodes",
        "specific_example": "Streaming architecture intentionally distributes vchannels unevenly based on pchannel/WAL balance - this is NOT a defect",
        "source_issue_numbers": [
          40638
        ],
        "affected_endpoints": [
          "entities+insert",
          "entities+upsert"
        ],
        "verdict": "DO_NOT_REPORT",
        "rationale": "Maintainer: 'Currently this situation is by design. Try to ensure that the delegator follows the WAL, and the WAL balance is based on the pchannel.'"
      },
      {
        "pattern": "Database crashing into degraded state on connection issues",
        "specific_example": "Database enters degraded state when querynode cannot connect to etcd - this is expected behavior",
        "source_issue_numbers": [
          36217,
          34416,
          38310
        ],
        "affected_endpoints": [
          "collections+load",
          "entities+search"
        ],
        "verdict": "DO_NOT_REPORT",
        "rationale": "Maintainer: 'expected behavior' - database enters degraded state when dependencies unavailable"
      },
      {
        "pattern": "Load partition stuck at 50%",
