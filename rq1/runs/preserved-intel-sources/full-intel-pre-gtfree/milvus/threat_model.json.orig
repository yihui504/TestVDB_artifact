  "trust_boundaries": {
    "trusted": [
      {
        "component": "Internal service-to-service calls (Proxy, QueryCoord, DataCoord, RootCoord)",
        "rationale": "Authenticated within cluster using internal mTLS"
      },
      {
        "component": "Admin API endpoints (users, roles, privileges)",
        "rationale": "Requires authentication and authorization"
      },
      {
        "component": "Local etcd cluster",
        "rationale": "Internal state management, not exposed externally"
      }
    ],
    "untrusted": [
      {
        "component": "Public REST API endpoints (entities, collections, partitions)",
        "rationale": "Exposed to external clients, subject to injection and fuzzing"
      },
      {
        "component": "SDK client input (pymilvus, Java SDK, Go SDK)",
        "rationale": "Client-controlled data, may be malicious or malformed"
      },
      {
        "component": "Bulk import files from external storage",
        "rationale": "User-provided data files, potentially malformed or malicious"
      }
    ],
    "assumptions": [
      "Docker/K8s network isolation between components",
      "etcd authentication is properly configured",
      "MinIO/S3 credentials are secured",
      "Internal gRPC communications use mTLS"
    ]
  },
  "cognitive_blindspots": {
    "blindspots": [
      {
        "blindspot_id": "BS-01",
        "name": "Parameter Coercion Trust",
        "description": "Developers over-trust framework/language automatic parameter validation and type coercion capabilities. API handlers accept invalid inputs instead of rejecting them with proper error codes.",
        "evidence": {
          "historical_defects": 37,
          "representative_issues": [37016, 36906, 38307, 39481, 43494],
          "developer_acknowledgment_rate": 0.87
        },
        "typical_manifestation": "REST handlers accept parameters without explicit validation (negative dimensions, incompatible types, missing required fields), leading to Type1_IllegalSuccess or Type3_RuntimeFailure",
        "attack_strategies": [
          "type_confusion_attack",
          "boundary_value_attack",
          "missing_param_attack"
        ],
        "defense_recommendation": "Add explicit parameter validation middleware at API gateway entry point for all incoming requests",
        "cross_db_transferable": true,
        "applicable_dbs": ["milvus", "qdrant", "weaviate", "pgvector"],
        "severity_impact": "P1/P2"
      },
      {
        "blindspot_id": "BS-03",
        "name": "Concurrency Blindness",
        "description": "Developers systematically underestimate concurrency-related data consistency issues. The codebase lacks proper synchronization for concurrent DML+DQL operations, load/release interleaving, and chaos recovery scenarios.",
        "evidence": {
          "historical_defects": 53,
          "representative_issues": [34983, 36228, 36989, 37209, 42098, 42404, 43592, 45274, 48903],
          "developer_acknowledgment_rate": 0.90
        },
        "typical_manifestation": "Concurrent searches during load/release cause 'channel not serviceable'; concurrent DML+DQL causes partition/collection not found; chaos recovery leads to timeout/OOM",
        "attack_strategies": [
          "race_condition_exploration",
          "state_consistency_attack",
          "chaos_recovery_attack"
        ],
        "defense_recommendation": "Implement proper locking and transactional semantics for state-changing operations, especially during load/release and DML+DQL interleaving",
        "cross_db_transferable": true,
        "applicable_dbs": ["milvus", "qdrant", "weaviate", "pgvector"],
        "severity_impact": "P0/P1"
      },
      {
        "blindspot_id": "BS-04",
        "name": "Boundary Default Optimism",
        "description": "Developers assume users won't input extreme values, relying on default values or downstream validation. Missing explicit min/max checks at API gateway.",
        "evidence": {
          "historical_defects": 16,
          "representative_issues": [36906, 38307, 43370, 44172, 45602],
          "developer_acknowledgment_rate": 0.88
        },
        "typical_manifestation": "dimension=-1 or limit=0 accepted with undefined behavior; OOM during bulk operations due to missing size limits",
        "attack_strategies": [
          "boundary_value_attack",
          "negative_value_attack",
          "resource_exhaustion_attack"
        ],
        "defense_recommendation": "Add explicit min/max validation for all numeric parameters at API gateway layer before processing",
        "cross_db_transferable": true,
        "applicable_dbs": ["milvus", "qdrant", "weaviate", "pgvector"],
        "severity_impact": "P1"
      },
      {
        "blindspot_id": "BS-05",
        "name": "Documentation Drift Blindness",
        "description": "API behavior has drifted from documentation without updates. Developers implement features that contradict documented contracts.",
        "evidence": {
          "historical_defects": 8,
          "representative_issues": [35969, 36261, 40638, 43295, 44517],
          "developer_acknowledgment_rate": 0.82
        },
        "typical_manifestation": "HTTP V2 returns code=0 instead of HTTP status codes; load stuck at 50% is documented as error but is actually expected behavior",
        "attack_strategies": [
          "api_contract_validation",
          "behavioral_drift_detection"
        ],
        "defense_recommendation": "Implement automated contract testing that compares API behavior against documentation, blocking releases with contract violations",
        "cross_db_transferable": true,
        "applicable_dbs": ["milvus", "qdrant", "weaviate", "pgvector"],
        "severity_impact": "P1/P2"
      },
      {
        "blindspot_id": "BS-02",
        "name": "Error Message Negligence",
        "description": "Developers prioritize success paths over error quality. Generic error messages ('Internal Error', 'Unknown Error') make debugging difficult.",
        "evidence": {
          "historical_defects": 4,
          "representative_issues": [37543, 36598],
          "developer_acknowledgment_rate": 0.65
        },
        "typical_manifestation": "Errors return 'Internal Error' instead of specific parameter violation messages; timeout errors don't specify which operation timed out",
        "attack_strategies": [
          "error_quality_evaluation",
          "diagnostic_gap_analysis"
        ],
        "defense_recommendation": "Establish error message quality standards and require specific error contexts in all error paths",
        "cross_db_transferable": true,
        "applicable_dbs": ["milvus", "qdrant", "weaviate", "pgvector"],
        "severity_impact": "P2"
      },
      {
        "blindspot_id": "BS-06",
        "name": "State Consistency Neglect",
        "description": "Developers assume immediate consistency across distributed components without verification. State drift between Proxy, QueryNode, DataNode after operations.",
        "evidence": {
          "historical_defects": 10,
          "representative_issues": [33774, 35131, 36404, 37574, 37677, 40207, 41570],
          "developer_acknowledgment_rate": 0.85
        },
        "typical_manifestation": "count(*) returns wrong number after delete; search returns empty despite data existing; upsert returns stale data",
        "attack_strategies": [
          "state_consistency_attack",
          "eventual_consistency_exploration"
        ],
        "defense_recommendation": "Add state verification probes after all mutating operations; implement read-after-write consistency checks",
        "cross_db_transferable": true,
        "applicable_dbs": ["milvus", "qdrant", "weaviate", "pgvector"],
        "severity_impact": "P1/P2"
      }
    ],
